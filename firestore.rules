rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection test path
    match /test/{testId} {
      allow read, write: if true;
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Banners collection
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // Coupons collection
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // Customers collection
    match /customers/{customerId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
