rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection: Anyone can read, signed in / admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Allow client & admin operations
    }

    // Categories collection: Anyone can read, signed in / admin can write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Banners collection: Anyone can read, signed in / admin can write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // Coupons collection: Anyone can read, signed in / admin can write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: Anyone can read and write (for customer checkout & admin order management)
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // Customers collection: Anyone can read and write (for customer registration, profile & admin customer management)
    match /customers/{customerId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
