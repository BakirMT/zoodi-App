{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "subcategory": { "type": "string", "maxLength": 100 },
        "image": { "type": "string", "maxLength": 200000 },
        "gallery": { "type": "array", "description": "List of gallery image URLs/base64" },
        "description": { "type": "string", "maxLength": 2000 },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "inStock": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "isTrending": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "price", "category", "image"]
    },
    "Category": {
      "title": "Category",
      "description": "Store category definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "subtitle": { "type": "string", "maxLength": 200 },
        "image": { "type": "string", "maxLength": 200000 },
        "itemCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerEmail": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "shippingAddress": { "type": "object" },
        "status": { "type": "string", "enum": ["Processing", "Shipped", "Delivered", "Cancelled"] },
        "trackingNumber": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerName", "total", "items", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer profile account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "avatar": { "type": "string", "maxLength": 200000 },
        "joinedDate": { "type": "string" },
        "totalOrders": { "type": "number" },
        "totalSpent": { "type": "number" },
        "walletBalance": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Hero banner / poster",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "tag": { "type": "string", "maxLength": 100 },
        "discount": { "type": "string", "maxLength": 50 },
        "image": { "type": "string", "maxLength": 200000 },
        "link": { "type": "string" },
        "active": { "type": "boolean" },
        "targetProductId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "image", "active"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Store discount code",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "maxLength": 50 },
        "discountPercent": { "type": "number" },
        "minPurchase": { "type": "number" },
        "expiresAt": { "type": "string" },
        "active": { "type": "boolean" },
        "usageCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "discountPercent", "active"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products collection"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Categories collection"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders collection"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer profiles collection"
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Banners and hero posters collection"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Coupons collection"
    }
  }
}
